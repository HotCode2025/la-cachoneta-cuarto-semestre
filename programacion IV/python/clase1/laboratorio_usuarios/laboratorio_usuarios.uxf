sobre la entidad Usuario (tabla usuario)</panel_attributes><additional_attributes></additional_attributes></element><element><id>UMLClass</id><coordinates><x>700</x><y>110</y><w>240</w><h>140</h></coordinates><panel_attributes>MenuAppUsuario
