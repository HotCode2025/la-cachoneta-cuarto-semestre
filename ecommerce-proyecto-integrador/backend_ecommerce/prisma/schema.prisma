generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model carrito_items {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  carrito_id  String    @db.Uuid
  producto_id String    @db.Uuid
  cantidad    Int
  carritos    carritos  @relation(fields: [carrito_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productos   productos @relation(fields: [producto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model carritos {
  id                  String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id          String          @unique @db.Uuid
  fecha_creacion      DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  fecha_actualizacion DateTime        @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  carrito_items       carrito_items[]
  usuarios            usuarios        @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model categorias {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre      String      @db.VarChar(100)
  descripcion String?
  productos   productos[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalle_pedidos {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pedido_id       String    @db.Uuid
  producto_id     String    @db.Uuid
  cantidad        Int
  precio_unitario Decimal   @db.Decimal(10, 2)
  subtotal        Decimal   @db.Decimal(10, 2)
  pedidos         pedidos   @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productos       productos @relation(fields: [producto_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model pagos {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pedido_id           String   @unique @db.Uuid
  mercadopago_id      String?  @db.VarChar(255)
  estado              String   @db.VarChar(50)
  monto               Decimal  @db.Decimal(10, 2)
  fecha_creacion      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  fecha_actualizacion DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  pedidos             pedidos  @relation(fields: [pedido_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model pedidos {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id      String            @db.Uuid
  fecha_creacion  DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  total           Decimal           @db.Decimal(10, 2)
  estado          String            @db.VarChar(50)
  detalle_pedidos detalle_pedidos[]
  pagos           pagos?
  usuarios        usuarios          @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model productos {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre          String            @db.VarChar(255)
  descripcion     String?
  precio          Decimal           @db.Decimal(10, 2)
  img             String?
  stock           Int
  categoria_id    String?           @db.Uuid
  activo          Boolean           @default(true)
  fecha_creacion  DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  carrito_items   carrito_items[]
  detalle_pedidos detalle_pedidos[]
  categorias      categorias?       @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model usuarios {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre         String    @db.VarChar(100)
  apellido       String    @db.VarChar(100)
  email          String    @unique @db.VarChar(255)
  pw             String    @db.VarChar(255)
  telefono       String?   @db.VarChar(50)
  rol            String    @db.VarChar(50)
  fecha_registro DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  activo         Boolean   @default(true)
  carritos       carritos?
  pedidos        pedidos[]
}
