{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-ecommerce-lc.onrender.com/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://backend-ecommerce-lc.onrender.com/images/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
